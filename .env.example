# ==========================================
# AgroArmour LSM Environment Configuration
# ==========================================

# -----------------
# Backend Services
# -----------------
PORT=5002
CLIENT_ORIGIN=http://localhost:8083
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/farm-management?retryWrites=true&w=majority
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# Optional Integrations
HUBSPOT_ACCESS_TOKEN=your-hubspot-token
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
PAYU_MERCHANT_KEY=your-payu-key
PAYU_MERCHANT_SALT=your-payu-salt
PAYTM_MERCHANT_ID=your-paytm-id
PAYTM_MERCHANT_KEY=your-paytm-key

# -----------------
# Frontend (Vite)
# -----------------
VITE_API_URL=https://agroarmour-backend.onrender.com
VITE_ML_API_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------
# Python ML Service
# -----------------
ML_PORT=5000
